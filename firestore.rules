rules_version = '2';

// Threat model: app pessoal de uso doméstico para 2 pessoas. Proteção contra
// acesso acidental por curiosos, não segurança robusta. Qualquer pessoa
// autenticada (anônimo conta) pode ler/escrever todos os documentos.
// O PIN compartilhado é o gate principal, validado client-side.

service cloud.firestore {
  match /databases/{database}/documents {
    match /household/{id} {
      allow read, write: if request.auth != null;
    }
    match /ingredients/{id} {
      allow read, write: if request.auth != null;
    }
    match /recipes/{id} {
      allow read, write: if request.auth != null;
    }
    match /hiddenRecipes/{id} {
      allow read, write: if request.auth != null;
    }
    match /userIngredients/{id} {
      allow read, write: if request.auth != null;
    }
    match /pantry/{id} {
      allow read, write: if request.auth != null;
    }
    match /shoppingList/{id} {
      allow read, write: if request.auth != null;
    }
    match /mealPlan/{day} {
      allow read, write: if request.auth != null;
    }
  }
}
