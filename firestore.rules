rules_version = '2';

// Regras UNIFICADAS para o projeto Firebase compartilhado pelos dois apps
// (ritual-app e app-alimentacao). Como ambos usam o mesmo login Google e o mesmo
// uid, cada app lê/escreve os próprios dados em `users/{uid}/...` — o app de
// comida em `users/{uid}/mealPlan/**`, `userMeals/**`, etc., e o ritual em
// `users/{uid}/dados/**`. O acesso requer login + aprovação (o dono, kly@sapo.pt,
// é aprovado automaticamente).
//
// Mantém este arquivo IDÊNTICO ao de ritual-app/firestore.rules: os dois repos
// publicam regras no mesmo projeto, então não podem divergir.
//
// Fluxo:
//   1. Usuário entra com Google → cria users/{uid} com status='pending'.
//   2. Admin (email kly@sapo.pt) aprova via UI ou Console (status='approved').
//   3. Somente após aprovação, o usuário pode ler/escrever seus próprios dados.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'kly@sapo.pt';
    }

    function isApprovedSelf(uid) {
      return isSignedIn()
        && request.auth.uid == uid
        && exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.status == 'approved';
    }

    // Registro de usuários
    match /users/{uid} {
      // Usuário lê o próprio doc; admin lê qualquer.
      allow get: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      // Apenas admin lista todos (para aprovar pendentes).
      allow list: if isAdmin();

      // Criação: somente o próprio usuário, email correto. Status deve ser
      // 'pending' — exceto o admin, que pode criar o próprio doc já aprovado.
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email
        && (
          request.resource.data.status == 'pending'
          || (isAdmin() && request.resource.data.status == 'approved')
        );

      // Update: usuário pode atualizar campos não-críticos do próprio doc
      // (sem mudar status nem email). Admin pode mudar qualquer coisa.
      allow update: if isAdmin() || (
        isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.status == resource.data.status
        && request.resource.data.email == resource.data.email
      );

      allow delete: if isAdmin();

      // Subcoleções com dados do usuário (mealPlan/, userMeals/, dados/, …):
      // somente o próprio se aprovado.
      match /{collection}/{docId} {
        allow read, write: if isApprovedSelf(uid);
      }
    }

    // Versão publicada do app do ritual (verificador de atualização in-app).
    // Leitura pública (sem dado pessoal); escrita só pelo backend (admin SDK).
    match /app/{doc} {
      allow read: if true;
      allow write: if false;
    }
  }
}
