# Firebase Web SDK config — pegue em: Firebase Console → Project Settings → Seus apps → Configuração
# Estes valores são "públicos" (vão para o bundle do cliente); a segurança vem das Firestore Security Rules.
# Para rodar local, copie este arquivo para .env.local e preencha.
# Para o deploy via GitHub Actions, adicione os mesmos valores como Secrets em:
#   Settings → Secrets and variables → Actions → New repository secret

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google Gemini (Google AI Studio) — usado para ler tabelas nutricionais por foto.
# Pegue uma chave gratuita em: https://aistudio.google.com/app/apikey
# ATENÇÃO: como as chaves Firebase acima, esta vai para o bundle do cliente.
# Restrinja a chave no Google Cloud Console (API: "Generative Language API") e,
# se possível, limite o uso. Sem esta chave o botão "Ler tabela por foto" fica oculto.
VITE_GEMINI_API_KEY=
# Opcional: modelo a usar (padrão: gemini-2.5-flash). Use um modelo com visão do free tier.
VITE_GEMINI_MODEL=
